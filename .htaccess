Options -Indexes

SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

<FilesMatch "^(config\.(local|example)|api_bootstrap)\.php$|^(Dockerfile|\.dockerignore|DEPLOY_ZEABUR\.md|SECURITY_NOTES\.md|apache-z-coc\.conf|php-production\.ini|package\.json|pnpm-lock\.yaml|tailwind\.config\.js|tailwind\.input\.css)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
        Satisfy All
    </IfModule>
</FilesMatch>

<FilesMatch "(^|[-.])(claimed|credentials?|tokens?|secrets?)([-.]|$)|\.cpa\..*\.json$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
        Satisfy All
    </IfModule>
</FilesMatch>

# Database migrations are deployment input, never public web content.
<FilesMatch "\.sql$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
        Satisfy All
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'"

    <FilesMatch "\.(?:css|js|svg|webp|png|jpg|jpeg|gif|woff2?|mp3)$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    </FilesMatch>

    <Files "index.html">
        Header add Link "</assets/art/generated/launch-ritual-moon-archive-v1.webp>; rel=preload; as=image; type=image/webp; fetchpriority=high"
    </Files>

    <FilesMatch "^launch-ritual-moon-archive-v1\.webp$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
